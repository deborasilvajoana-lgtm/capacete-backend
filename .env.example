# MQTT / HiveMQ (segredos somente no backend)
MQTT_HOST=SEU_HOST_HIVEMQ
MQTT_PORT=8883
MQTT_USER=SEU_USUARIO_MQTT
MQTT_PASS=COLOQUE_A_SENHA_MQTT_ATUAL_AQUI
MQTT_TOPICS=capacete/status,capacete/+/status

# Firebase Admin
FIREBASE_DATABASE_URL=https://capacete-inteligente-bf599-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Compatibilidade / dispositivo padrão
DEFAULT_DEVICE_ID=default
DEFAULT_FUNCIONARIO=Funcionario nao vinculado
DEFAULT_EPI=Capacete 01
DEFAULT_OBRA=
OFFLINE_GAP_SECONDS=120
ENABLE_LEGACY_MIRROR=true

# Endpoints de teste: manter desabilitados em produção
ENABLE_TEST_ENDPOINTS=false
ADMIN_TEST_TOKEN=GERAR_SOMENTE_SE_FOR_HABILITAR_TESTES

# Bootstrap opcional da Administração Geral
PLATFORM_ADMIN_EMAIL=admin@exemplo.com
PLATFORM_ADMIN_NAME=Administracao Geral
PLATFORM_ADMIN_PASSWORD=TROQUE_E_REMOVA_DEPOIS_DO_BOOTSTRAP

# Bootstrap opcional de uma empresa
BOOTSTRAP_USER_EMAIL=admin.empresa@exemplo.com
BOOTSTRAP_USER_PASSWORD=TROQUE_E_REMOVA_DEPOIS_DO_BOOTSTRAP
BOOTSTRAP_USER_NAME=Administrador da Empresa
BOOTSTRAP_USER_ROLE=admin
BOOTSTRAP_COMPANY_CNPJ=00000000000000
BOOTSTRAP_COMPANY_LEGAL_NAME=Empresa Exemplo Ltda
BOOTSTRAP_COMPANY_TRADE_NAME=Empresa Exemplo
BOOTSTRAP_COMPANY_EMAIL=
BOOTSTRAP_COMPANY_PHONE=
BOOTSTRAP_COMPANY_ADDRESS=
BOOTSTRAP_COMPANY_CITY=Sao Paulo
BOOTSTRAP_COMPANY_STATE=SP
BOOTSTRAP_COMPANY_RESPONSIBLE=
BOOTSTRAP_SST_RESPONSIBLE=
BOOTSTRAP_DEVICE_ID=
BOOTSTRAP_EMPLOYEE_ID=
BOOTSTRAP_HELMET_ID=
BOOTSTRAP_HELMET_CODE=
BOOTSTRAP_WORKSITE_ID=

# Mary IA online (segredo somente no backend)
MARY_AI_ENABLED=true
OPENROUTER_API_KEY=COLOQUE_A_CHAVE_NO_RENDER_NUNCA_NO_APK
OPENROUTER_MODEL=COLOQUE_O_MODELO_DISPONIVEL_NO_OPENROUTER
OPENROUTER_SITE_URL=https://SEU-SITE-OU-PAINEL.example

# Autorização via e-mail HTTPS (Render Free bloqueia SMTP 25/465/587)
APPROVAL_ADMIN_EMAIL=SEU_EMAIL_VERIFICADO_NO_FIREBASE
BREVO_API_KEY=CHAVE_API_BREVO_DIGITADA_SO_NO_RENDER
BREVO_SENDER_EMAIL=REMETENTE_VERIFICADO_NO_BREVO

# MQTT legado e novos dispositivos
# MQTT_TOPIC=capacete/status (existente no Render, continua suportado)
# MQTT_TOPICS=capacete/status,capacete/+/status (opcional; padrão da versão 3.5)
